[
  {
    "line": 1,
    "text": "名門·私立百花王學園。"
  },
  {
    "line": 3,
    "text": "是贏家的天堂。"
  },
  {
    "line": 4,
    "text": "是敗者的地獄。"
  },
  {
    "line": 5,
    "text": "歡迎來到由勝負支配的瘋狂世界，加入這場令人心潮澎湃的狂歡。"
  },
  {
    "line": 6,
    "text": "勝負無時無刻都存在，即便……"
  },
  {
    "line": 8,
    "text": "以學生會為頂點的此處是學校，亦是弱肉強食的階級社會。"
  },
  {
    "line": 9,
    "text": "是輕輕鬆鬆的修學旅行，那又何妨~"
  }
]
