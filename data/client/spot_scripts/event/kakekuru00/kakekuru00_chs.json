[
  {
    "line": 1,
    "text": "名门·私立百花王学园。"
  },
  {
    "line": 3,
    "text": "是赢家的天堂。"
  },
  {
    "line": 4,
    "text": "是败者的地狱。"
  },
  {
    "line": 5,
    "text": "欢迎来到由胜负支配的疯狂世界，加入这场令人心潮澎湃的狂欢。"
  },
  {
    "line": 6,
    "text": "胜负无时无刻都存在，即便……"
  },
  {
    "line": 8,
    "text": "以学生会为顶点的此处是学校，亦是弱肉强食的阶级社会。"
  },
  {
    "line": 9,
    "text": "是轻轻松松的修学旅行，那又何妨~"
  }
]
